{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/run.schema.json",
  "title": "Research run and confirmed-request binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "request_id", "slug", "confirmation_binding"
  ],
  "properties": {
    "schema_version": {"const": "research-run/v1"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "request_id": {"type": "string", "pattern": "^RSR-[0-9]{6}$"},
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "confirmation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256", "confirming_authority", "method", "confirmed_at",
        "work_order_sha256"
      ],
      "properties": {
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "confirming_authority": {"type": "string", "minLength": 1},
        "method": {"enum": ["INTERACTIVE", "WORK_ORDER"]},
        "confirmed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "work_order_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "INTERACTIVE"}}},
          "then": {"properties": {"work_order_sha256": {"type": "null"}}}
        },
        {
          "if": {"properties": {"method": {"const": "WORK_ORDER"}}},
          "then": {
            "properties": {
              "work_order_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
