{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/evidence.schema.json",
  "title": "Bounded research evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "record_version", "run_id", "evidence_id",
    "lifecycle_status", "readiness_status", "owner", "decision_authority", "created_at_utc",
    "source_refs", "evidence_refs", "decision_refs", "supersedes", "stale_if",
    "question_ids", "source_id", "source_sha256",
    "locator", "representation", "polarity", "content", "content_sha256", "extracted_at"
  ],
  "properties": {
    "schema_version": {"const": "research-evidence/v1"},
    "record_id": {"type": "string", "pattern": "^EVD-[0-9]{6}$"},
    "record_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "evidence_id": {"type": "string", "pattern": "^EVD-[0-9]{6}$"},
    "lifecycle_status": {"enum": ["DRAFT", "PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED", "ARCHIVED"]},
    "readiness_status": {"enum": ["NOT_READY", "READY", "STALE"]},
    "owner": {"type": "string", "minLength": 1},
    "decision_authority": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}},
    "decision_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-[0-9]{6}$"}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(RQ|QRY|SRC|EVD|CLM|CTR|VER|SYN|DEC|HND)-[0-9]{6}$"}},
    "stale_if": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "question_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RQ-[0-9]{6}$"}
    },
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{6}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "locator": {"type": "string", "minLength": 1},
    "representation": {"enum": ["PARAPHRASE", "EXCERPT", "OBSERVATION"]},
    "polarity": {"enum": ["SUPPORTING", "CONTRARY", "NEUTRAL"]},
    "content": {"type": "string", "minLength": 1, "maxLength": 12000},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extracted_at": {"type": "string", "format": "date-time"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
