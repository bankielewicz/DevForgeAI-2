{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/claim.schema.json",
  "title": "Atomic research claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "record_version", "run_id", "claim_id",
    "lifecycle_status", "readiness_status", "owner", "decision_authority", "created_at_utc",
    "source_refs", "evidence_refs", "decision_refs", "supersedes", "stale_if",
    "question_ids", "claim_type", "text", "scope",
    "support_evidence_ids", "contradiction_ids", "confidence", "author", "status"
  ],
  "properties": {
    "schema_version": {"const": "research-claim/v1"},
    "record_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
    "record_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
    "lifecycle_status": {"enum": ["DRAFT", "PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED", "ARCHIVED"]},
    "readiness_status": {"enum": ["NOT_READY", "READY", "STALE"]},
    "owner": {"type": "string", "minLength": 1},
    "decision_authority": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}},
    "decision_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-[0-9]{6}$"}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(RQ|QRY|SRC|EVD|CLM|CTR|VER|SYN|DEC|HND)-[0-9]{6}$"}},
    "stale_if": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "question_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RQ-[0-9]{6}$"}
    },
    "claim_type": {"enum": ["SOURCE_FACT", "STATIC_OBSERVATION", "IMPORTED_EMPIRICAL_OBSERVATION", "USER_OBSERVATION", "INFERENCE", "PROPOSAL"]},
    "text": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "support_evidence_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}
    },
    "contradiction_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CTR-[0-9]{6}$"}
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_fidelity", "scope_match", "freshness", "corroboration", "empirical_support", "contradiction", "rationale"],
      "properties": {
        "source_fidelity": {"enum": ["HIGH", "MEDIUM", "LOW", "UNASSESSED"]},
        "scope_match": {"enum": ["EXACT", "PARTIAL", "UNKNOWN"]},
        "freshness": {"enum": ["CURRENT", "AGING", "STALE", "UNKNOWN"]},
        "corroboration": {"enum": ["NONE", "SINGLE", "MULTIPLE_INDEPENDENT"]},
        "empirical_support": {"enum": ["NONE", "STATIC", "EXECUTED", "REPLICATED"]},
        "contradiction": {"enum": ["NONE_KNOWN", "OPEN", "RESOLVED"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "session_id"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "risk_characteristics": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["VOLATILE", "COMPARATIVE", "SAFETY", "PERFORMANCE", "SCALABILITY", "OBSERVATIONAL"]}
    },
    "status": {"enum": ["CANDIDATE", "REJECTED", "SUPERSEDED", "STALE"]},
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "superseded_claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"claim_type": {"enum": ["SOURCE_FACT", "INFERENCE"]}}, "required": ["claim_type"]},
      "then": {"properties": {"support_evidence_ids": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "CANDIDATE"}}, "required": ["status"]},
      "then": {
        "properties": {
          "lifecycle_status": {"const": "PROPOSED"},
          "readiness_status": {"const": "READY"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "REJECTED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "lifecycle_status": {"const": "REJECTED"},
          "readiness_status": {"const": "NOT_READY"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "SUPERSEDED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "lifecycle_status": {"const": "SUPERSEDED"},
          "readiness_status": {"const": "STALE"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "STALE"}}, "required": ["status"]},
      "then": {
        "properties": {
          "lifecycle_status": {"const": "PROPOSED"},
          "readiness_status": {"const": "STALE"}
        }
      }
    }
  ]
}
