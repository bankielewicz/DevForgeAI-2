{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/request.schema.json",
  "title": "Normalized Research request entry envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "project_id", "slug", "mode", "caller",
    "authority", "questions", "intended_downstream_use", "linked_refs", "hypotheses",
    "scope", "as_of", "risk_tier", "source_policy", "existing_refs", "budget",
    "execution_policy", "completion_criteria", "stop_conditions", "escalation_owner_id",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "research-request/v1"},
    "request_id": {"type": "string", "pattern": "^RSR-[0-9]{6}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
    "mode": {"enum": ["STANDALONE", "EMBEDDED", "REFRESH", "CHALLENGE", "IMPACT"]},
    "caller": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow", "requesting_phase", "return_route"],
      "properties": {
        "workflow": {"type": "string", "minLength": 1},
        "requesting_phase": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "return_route": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": [
        "requester_id", "phase_owner_id", "decision_authority_id",
        "confirming_authority_id", "persistence_authorized"
      ],
      "properties": {
        "requester_id": {"type": "string", "minLength": 1},
        "phase_owner_id": {"type": "string", "minLength": 1},
        "decision_authority_id": {"type": "string", "minLength": 1},
        "confirming_authority_id": {"type": "string", "minLength": 1},
        "persistence_authorized": {"const": true},
        "work_order_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question_id", "text", "completion_criteria"],
        "properties": {
          "question_id": {"type": "string", "pattern": "^RQ-[0-9]{6}$"},
          "text": {"type": "string", "minLength": 1},
          "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "intended_downstream_use": {"type": "string", "minLength": 1},
    "linked_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": {"const": "UNVERIFIED_HYPOTHESIS"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "as_of": {"type": "string", "format": "date-time"},
    "risk_tier": {"enum": ["LOW", "MATERIAL", "CRITICAL"]},
    "source_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["required_classes", "prohibited_classes", "freshness_requirements"],
      "properties": {
        "required_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "prohibited_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "freshness_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "existing_refs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "artifact_id", "version", "sha256"],
        "properties": {
          "kind": {"enum": ["SOURCE", "CLAIM", "PACKAGE", "CONTEXT_MANIFEST"]},
          "artifact_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "limits", "confirmed_overrides"],
      "properties": {
        "profile": {"enum": ["quick", "standard", "deep"]},
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["atomic_questions", "research_lanes", "concurrent_workers", "discovery_queries", "admitted_sources", "external_tool_calls", "aggregate_model_tokens", "context_bytes", "elapsed_minutes", "retry_per_failed_lane"],
          "properties": {
            "atomic_questions": {"type": "integer", "minimum": 1, "maximum": 24},
            "research_lanes": {"type": "integer", "minimum": 2, "maximum": 10},
            "concurrent_workers": {"type": "integer", "minimum": 1, "maximum": 5},
            "discovery_queries": {"type": "integer", "minimum": 2, "maximum": 150},
            "admitted_sources": {"type": "integer", "minimum": 1, "maximum": 100},
            "external_tool_calls": {"type": "integer", "minimum": 1, "maximum": 450},
            "aggregate_model_tokens": {"type": "integer", "minimum": 1, "maximum": 750000},
            "context_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
            "elapsed_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
            "retry_per_failed_lane": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        },
        "confirmed_overrides": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["field", "value", "authority_id"],
            "properties": {
              "field": {"type": "string", "minLength": 1},
              "value": {"type": "integer", "minimum": 0},
              "authority_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "execution_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["write_fence", "network_policy", "network_allowlist"],
      "properties": {
        "write_fence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
        "network_policy": {"enum": ["DENY", "ALLOWLIST", "OPEN"]},
        "network_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?://(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?|\\[[0-9a-f:]+\\])(?::[0-9]{1,5})?$"
          }
        }
      }
    },
    "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "escalation_owner_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_policy": {
            "properties": {"network_policy": {"const": "DENY"}},
            "required": ["network_policy"]
          }
        },
        "required": ["execution_policy"]
      },
      "then": {
        "properties": {
          "execution_policy": {
            "properties": {"network_allowlist": {"maxItems": 0}},
            "required": ["network_allowlist"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_policy": {
            "properties": {"network_policy": {"const": "ALLOWLIST"}},
            "required": ["network_policy"]
          }
        },
        "required": ["execution_policy"]
      },
      "then": {
        "properties": {
          "execution_policy": {
            "properties": {"network_allowlist": {"minItems": 1}},
            "required": ["network_allowlist"]
          }
        }
      }
    }
  ]
}
