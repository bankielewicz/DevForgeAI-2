{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/verification.schema.json",
  "title": "Independent single-claim verification bound to a canonical packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "record_version", "run_id", "verification_id",
    "lifecycle_status", "readiness_status", "owner", "decision_authority", "created_at_utc",
    "source_refs", "evidence_refs", "decision_refs", "supersedes", "stale_if",
    "claim_id", "packet_ref", "claim_binding", "reference_sets", "verifier",
    "provider_conformance", "session_binding", "launched_at", "completed_at",
    "raw_result_sha256", "broker_launch_receipt_sha256", "checks", "outcome", "limitations"
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "relevant_ids"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "COULD_NOT_RUN", "INFRA_FAILURE"]},
        "reason": {"type": "string", "minLength": 1},
        "relevant_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(CLM|SRC|EVD|CTR)-[0-9]{6}$"}
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "research-verification/v1"},
    "record_id": {"type": "string", "pattern": "^VER-[0-9]{6}$"},
    "record_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "verification_id": {"type": "string", "pattern": "^VER-[0-9]{6}$"},
    "lifecycle_status": {"enum": ["DRAFT", "PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED", "ARCHIVED"]},
    "readiness_status": {"enum": ["NOT_READY", "READY", "STALE"]},
    "owner": {"type": "string", "minLength": 1},
    "decision_authority": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}
    },
    "evidence_refs": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}
    },
    "decision_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DEC-[0-9]{6}$"}
    },
    "supersedes": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(RQ|QRY|SRC|EVD|CLM|CTR|VER|SYN|DEC|HND)-[0-9]{6}$"}
    },
    "stale_if": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
    "packet_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "path", "sha256", "byte_length"],
      "properties": {
        "packet_id": {"type": "string", "pattern": "^VPK-[0-9]{6}$"},
        "path": {"type": "string", "pattern": "^verification-packets/VPK-[0-9]{6}\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "claim_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "record_version", "claim_sha256"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
        "record_version": {"type": "integer", "minimum": 1},
        "claim_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reference_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "evidence_ids", "contradiction_ids"],
      "properties": {
        "source_ids": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}
        },
        "evidence_ids": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}
        },
        "contradiction_ids": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CTR-[0-9]{6}$"}
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id", "session_id", "kind", "provider", "model", "provider_version",
        "adapter_sha256", "profile_sha256"
      ],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["HUMAN", "PROVIDER_AGENT", "DETERMINISTIC_ORACLE", "OFFLINE_TEST_HARNESS"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "adapter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provider_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_id", "attestation_sha256"],
      "properties": {
        "attestation_id": {"type": "string", "pattern": "^PCA-[0-9]{6}$"},
        "attestation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "session_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_session_id", "child_session_id", "context_mode"],
      "properties": {
        "parent_session_id": {"type": "string", "minLength": 1},
        "child_session_id": {"type": "string", "minLength": 1},
        "context_mode": {"const": "PACKET_ONLY"}
      }
    },
    "launched_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "completed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "raw_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "broker_launch_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entailment", "scope_match", "citation_resolution", "source_admission",
        "custody_integrity", "freshness", "corroboration", "contradictions_considered"
      ],
      "properties": {
        "entailment": {"$ref": "#/$defs/check"},
        "scope_match": {"$ref": "#/$defs/check"},
        "citation_resolution": {"$ref": "#/$defs/check"},
        "source_admission": {"$ref": "#/$defs/check"},
        "custody_integrity": {"$ref": "#/$defs/check"},
        "freshness": {"$ref": "#/$defs/check"},
        "corroboration": {"$ref": "#/$defs/check"},
        "contradictions_considered": {"$ref": "#/$defs/check"}
      }
    },
    "outcome": {"enum": ["PASS", "FAIL", "COULD_NOT_RUN", "INFRA_FAILURE"]},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
