{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/verification-packet.schema.json",
  "title": "Bias-minimized single-claim verification packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_id", "run_id", "request_binding", "claim",
    "sources", "evidence", "contradictions"
  ],
  "properties": {
    "schema_version": {"const": "research-verification-packet/v1"},
    "packet_id": {"type": "string", "pattern": "^VPK-[0-9]{6}$"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "request_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "request_sha256", "request"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^RSR-[0-9]{6}$"},
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "request": {"type": "object"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id", "record_version", "claim_sha256", "text", "claim_type", "scope"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
        "record_version": {"type": "integer", "minimum": 1},
        "claim_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "text": {"type": "string", "minLength": 1},
        "claim_type": {
          "enum": [
            "SOURCE_FACT", "STATIC_OBSERVATION", "IMPORTED_EMPIRICAL_OBSERVATION",
            "USER_OBSERVATION", "INFERENCE", "PROPOSAL"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude"],
          "properties": {
            "include": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "exclude": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "sources": {
      "type": "array", "maxItems": 16,
      "items": {"type": "object"}
    },
    "evidence": {
      "type": "array", "maxItems": 16,
      "items": {"type": "object"}
    },
    "contradictions": {
      "type": "array", "maxItems": 16,
      "items": {"type": "object"}
    }
  }
}
