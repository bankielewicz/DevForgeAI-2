{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/contradiction.schema.json",
  "title": "Research contradiction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "record_version", "run_id", "contradiction_id",
    "lifecycle_status", "readiness_status", "owner", "decision_authority", "created_at_utc",
    "source_refs", "evidence_refs", "decision_refs", "supersedes", "stale_if",
    "claim_id", "evidence_ids", "description", "severity", "status"
  ],
  "properties": {
    "schema_version": {"const": "research-contradiction/v1"},
    "record_id": {"type": "string", "pattern": "^CTR-[0-9]{6}$"},
    "record_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "contradiction_id": {"type": "string", "pattern": "^CTR-[0-9]{6}$"},
    "lifecycle_status": {"enum": ["DRAFT", "PROPOSED", "ACCEPTED", "REJECTED", "SUPERSEDED", "ARCHIVED"]},
    "readiness_status": {"enum": ["NOT_READY", "READY", "STALE"]},
    "owner": {"type": "string", "minLength": 1},
    "decision_authority": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}},
    "decision_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-[0-9]{6}$"}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(RQ|QRY|SRC|EVD|CLM|CTR|VER|SYN|DEC|HND)-[0-9]{6}$"}},
    "stale_if": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{6}$"},
    "evidence_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}
    },
    "description": {"type": "string", "minLength": 1},
    "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "status": {"enum": ["OPEN", "RESOLVED", "ACCEPTED_UNCERTAINTY"]},
    "resolution": {"type": "string", "minLength": 1},
    "resolution_authority_id": {"type": "string", "minLength": 1},
    "resolved_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["RESOLVED", "ACCEPTED_UNCERTAINTY"]}}, "required": ["status"]},
      "then": {"required": ["resolution", "resolution_authority_id", "resolved_at"]}
    }
  ]
}
