{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devforgeai.dev/schemas/research/v1/decision.schema.json",
  "title": "Named human Research-process decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "record_version", "decision_id", "run_id",
    "lifecycle_status", "readiness_status", "owner", "decision_authority",
    "created_at_utc", "source_refs", "evidence_refs", "decision_refs",
    "supersedes", "stale_if", "decision_type", "status", "risk_tier",
    "subject_refs", "decision_text", "rationale", "scope", "constraints",
    "authority_id", "authority_basis", "decided_at_utc", "effective_until_utc",
    "downstream_acceptance"
  ],
  "properties": {
    "schema_version": {"const": "research-decision/v1"},
    "record_id": {"type": "string", "pattern": "^DEC-[0-9]{6}$"},
    "record_version": {"type": "integer", "minimum": 1},
    "decision_id": {"type": "string", "pattern": "^DEC-[0-9]{6}$"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "lifecycle_status": {"enum": ["ACCEPTED", "REJECTED", "SUPERSEDED"]},
    "readiness_status": {"enum": ["READY", "STALE"]},
    "owner": {"type": "string", "minLength": 1},
    "decision_authority": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{6}$"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[0-9]{6}$"}},
    "decision_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-[0-9]{6}$"}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DEC-[0-9]{6}$"}},
    "stale_if": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decision_type": {
      "enum": [
        "SCOPE", "BUDGET", "ACCESS", "PERMITTED_WAIVER", "CANCELLATION",
        "CONFLICT_RESOLUTION"
      ]
    },
    "status": {"enum": ["ACCEPTED", "REJECTED", "REVOKED"]},
    "risk_tier": {"enum": ["LOW", "MATERIAL", "CRITICAL"]},
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_text": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authority_id": {"type": "string", "minLength": 1},
    "authority_basis": {"type": "string", "minLength": 1},
    "decided_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "effective_until_utc": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time", "pattern": "Z$"}
      ]
    },
    "downstream_acceptance": {"const": false},
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_rule", "applies_to", "residual_risk", "review_trigger"],
      "properties": {
        "policy_rule": {"type": "string", "minLength": 1},
        "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "residual_risk": {"type": "string", "minLength": 1},
        "review_trigger": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ACCEPTED"}}},
      "then": {"properties": {"lifecycle_status": {"const": "ACCEPTED"}}}
    },
    {
      "if": {"properties": {"status": {"const": "REJECTED"}}},
      "then": {"properties": {"lifecycle_status": {"const": "REJECTED"}}}
    },
    {
      "if": {"properties": {"status": {"const": "REVOKED"}}},
      "then": {"properties": {"lifecycle_status": {"const": "SUPERSEDED"}}}
    },
    {
      "if": {"properties": {"decision_type": {"const": "PERMITTED_WAIVER"}}},
      "then": {
        "required": ["waiver"],
        "properties": {
          "risk_tier": {"enum": ["LOW", "MATERIAL"]},
          "effective_until_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      },
      "else": {"not": {"required": ["waiver"]}}
    }
  ]
}
