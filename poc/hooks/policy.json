{
  "protected_paths": [
    ".claude/settings.json",
    ".claude/hooks/*",
    ".claude/hooks/**",
    ".devforgeai/state.yaml",
    ".devforgeai/provenance/**",
    "CLAUDE.md",
    ".env",
    "**/.env"
  ],
  "deny_outside_project": true,
  "denied_commands": [
    "\\brm\\s+-[a-zA-Z]*r[a-zA-Z]*f\\s+/(\\s|$)",
    "\\bgit\\s+push\\b.*(--force|-f)\\b",
    "\\bgit\\s+reset\\s+--hard\\b",
    "\\bgit\\s+clean\\b",
    "\\bcurl\\b.*\\|\\s*(ba)?sh\\b"
  ],
  "ask_commands": [
    "\\bgit\\s+push\\b"
  ],
  "receipt_agents": [
    "red_dev",
    "green_dev",
    "refactor_dev"
  ]
}
