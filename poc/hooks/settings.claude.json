{
  "_comment": "Merge the `hooks` block into <project>/.claude/settings.json. One hookd entry per event; checks are selected in code, so adding a check never touches this file. Exec form (command + args) avoids shell quoting. timeout 10 > HOOKD_ALARM_SECONDS 6.",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/hookd.py"], "timeout": 10, "statusMessage": "hookd self-test"}]}
    ],
    "PreToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
       "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/hookd.py"], "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/hookd.py"], "timeout": 10}]}
    ],
    "SubagentStop": [
      {"matcher": "*",
       "hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/hookd.py"], "timeout": 10, "statusMessage": "hookd receipt check"}]}
    ]
  }
}
